# Build artifacts
build/
bin/
*.o
*.so
*.dylib
*.a

# External libraries
LIBS/

# Simulation outputs
simulation/results_simulation/
simulation/simulated_*
simulation/*.bin
# simulation/*.txt -> commented out because simulation/params_sim.txt is needed
# Use whitelist for simulation txt files if needed, but params_sim.txt is tracked
simulation/valid_hkls.csv

# System
.DS_Store
.vscode/

# Large data
*.h5
*.tif
100MilOrients.bin
__pycache__/

# Python distribution artifacts (packages/*/). Built by release.sh and CI;
# never committed. `build/` above already covers packages/*/build/.
dist/
*.egg-info/
.eggs/
*.egg


# Local IDE / tooling.
# `.claude/*` and not `.claude/`: git does not descend into an excluded DIRECTORY,
# so a negation under it never matches. Excluding the contents keeps the directory
# walkable and lets shared skills be re-included.
.claude/*
# Shared skills ARE project assets -- a skill that ships with the clone is usable
# by whoever checks the repo out. Personal settings and session state stay ignored.
!.claude/skills/
